{
  "name": "@lyngmn/dsh-footnote-hover",
  "version": "1.0.0",
  "private": true,
  "description": "Previews a footnote when you rest the pointer on its number, and jumps to it when you click, in chat answers and the markdown preview. Click ↩ to go back. Not an official DeepSeek plugin.",
  "author": "LYNGMN",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LYNGMN/dsh-korean.git",
    "directory": "plugins/footnote-hover"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "locale"
      ]
    }
  }
}
