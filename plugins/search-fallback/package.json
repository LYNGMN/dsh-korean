{
  "name": "@lyngmn/dsh-search-fallback",
  "version": "1.0.0",
  "private": true,
  "description": "When a web search provider fails or finds nothing, the same query runs on the next one. Pick the order in the web search settings. Not an official DeepSeek plugin.",
  "author": "LYNGMN",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "host-locale.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LYNGMN/dsh-korean.git",
    "directory": "plugins/search-fallback"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
