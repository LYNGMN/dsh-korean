{
  "name": "@lyngmn/dsh-path-links",
  "version": "1.0.0",
  "private": true,
  "description": "In the markdown preview, click an absolute path shown as code to open that file in a new tab, or click ↗ beside it to show it in Finder. Not an official DeepSeek plugin.",
  "author": "LYNGMN",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LYNGMN/dsh-korean.git",
    "directory": "plugins/path-links"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "locale"
      ]
    }
  }
}
