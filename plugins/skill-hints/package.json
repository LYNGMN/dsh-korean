{
  "name": "@lyngmn/dsh-skill-hints",
  "version": "1.0.0",
  "private": true,
  "description": "Shows a grey input hint after /skill in the composer, matches skill menu descriptions to your DSH language, and adds /skill-hints to check them. Not an official DeepSeek plugin.",
  "author": "LYNGMN",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "skills.js",
    "sync.js",
    "host-locale.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LYNGMN/dsh-korean.git",
    "directory": "plugins/skill-hints"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
