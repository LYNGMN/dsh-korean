{
  "name": "@lyngmn/dsh-code-map",
  "version": "1.1.1",
  "private": true,
  "description": "Adds a Code Map conversation tab with relevant code locations and places to check after a change. Not an official DeepSeek plugin.",
  "author": "LYNGMN",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LYNGMN/dsh-korean.git",
    "directory": "plugins/code-map"
  },
  "engines": {
    "node": ">=22.15"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
